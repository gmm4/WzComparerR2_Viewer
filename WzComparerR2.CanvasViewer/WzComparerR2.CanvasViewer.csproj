<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net6.0-windows;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <WcR2Plugin>true</WcR2Plugin>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <Import Project="..\Build\Common.props" />
  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Canvas Viewer</AssemblyTitle>
    <Description>On-demand Canvas gallery for WzComparerR2</Description>
    <MainProgramOutputDir>$(MSBuildThisFileDirectory)..\WzComparerR2\bin\$(Configuration)\$(TargetFramework)</MainProgramOutputDir>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WzComparerR2.CanvasViewer.Tests" />
    <ProjectReference Include="..\WzComparerR2\WzComparerR2.csproj" Private="false" ExcludeAssets="all" />
    <ProjectReference Include="..\WzComparerR2.PluginBase\WzComparerR2.PluginBase.csproj" Private="false" ExcludeAssets="all" />
    <ProjectReference Include="..\WzComparerR2.WzLib\WzComparerR2.WzLib.csproj" Private="false" ExcludeAssets="all" />
    <Reference Include="DevComponents.DotNetBar2">
      <HintPath>..\References\DevComponents.DotNetBar2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="$(DotnetEdition) == 'framework'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <Import Project="..\Build\WcR2Plugin.targets" />
</Project>
